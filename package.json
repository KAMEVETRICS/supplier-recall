{
  "name": "supplier-recall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests *.ts *.mjs tsconfig.json",
    "format:check": "prettier --check src scripts tests *.ts *.mjs tsconfig.json",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "probe": "tsx scripts/probe-integrations.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "submission:verify": "tsx scripts/verify-submission.ts",
    "runtime": "node --version",
    "operator:password": "tsx scripts/operator-password.ts",
    "postinstall": "node scripts/prepare-wasm.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@libsql/client": "^0.17.0",
    "@mysten-incubation/memwal": "0.1.13",
    "ai": "^7.0.0",
    "csv-parse": "^6.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.4.5",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "node": "24.22.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "node@24.22.2": true,
    "esbuild@0.28.2": true
  }
}
