# Copy to .env.local; keep secrets here, never in chat or browser source.
APP_MODE=sample
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=file:./data/recall.db
DATABASE_AUTH_TOKEN=
# Quote extraction: any OpenAI-compatible chat API over HTTPS. Default is NVIDIA (keys from build.nvidia.com start with nvapi-).
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
# Verified with NVIDIA on November 9, 2026. Some listed NVIDIA models return "Not found for account" on free keys.
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
TAVILY_API_KEY=
TATUM_API_KEY=
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=supplier-recall-demo
OPERATOR_PASSWORD_HASH=
SESSION_SECRET=
# Public deployment only: header overwritten by your trusted reverse proxy.
# Leave empty for localhost; public login is disabled until this is configured.
AUTH_TRUSTED_SOURCE_HEADER=
SUI_SAMPLE_DIGEST=
# Local JSON invoice file, with independently known expected payment fields.
SUI_SAMPLE_INVOICE_PATH=
# Deployments: the same invoice as one-line JSON (read by the public /live page).
SUI_SAMPLE_INVOICE_JSON=
